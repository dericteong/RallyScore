# Copy this file to the repo root as `keystore.properties` and fill in real values.
# `keystore.properties` is git-ignored and MUST NEVER be committed.
#
# Create the keystore first (run from the repo root, choose your own passwords):
#   keytool -genkeypair -v -keystore rallyscore-release.jks \
#     -alias rallyscore -keyalg RSA -keysize 2048 -validity 10000
